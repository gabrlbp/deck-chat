{
  "name": "deck-chat",
  "version": "0.1.5",
  "private": true,
  "license": "MIT",
  "description": "Contas do PokeIdle em grid + presença da main nos chats da Twitch",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "svelte-check --tsconfig ./tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:win:zip": "electron-vite build && electron-builder --win zip --x64 --publish never -c.win.signAndEditExecutable=false"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "valibot": "^1.5.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
